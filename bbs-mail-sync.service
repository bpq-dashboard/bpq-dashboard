[Unit]
Description=BPQ Dashboard — copy BBS mail into the IMAP mail store
After=network.target mysql.service mariadb.service dovecot.service

[Service]
Type=oneshot
# Root, because Dovecot's delivery program (dovecot-lda) must start as root
# to write as the mail store's own user (bpqmail). Optional add-on, set up by
# tools/bbs-mail-setup.sh. See scripts/bbs-mail-sync.py.
User=root
ExecStart=/usr/bin/python3 /var/www/bpq-dashboard/scripts/bbs-mail-sync.py
TimeoutStartSec=30min
Nice=10
ProtectHome=yes
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

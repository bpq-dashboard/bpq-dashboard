#!/bin/bash
# ============================================================================
#  bpq-dashboard-set-admin-password — change ONE existing admin login's
#  password in the dashboard's password file (v1.5.19).
#
#  Installed by install.sh as root:root 755 in /usr/local/sbin (never run
#  from the web folder: the web user can write there). One sudoers line in
#  /etc/sudoers.d/www-data-tools lets the web user run it, for the
#  Maintenance page's "Change admin password" card (admin/maintenance-api.php).
#
#  Usage:  sudo bpq-dashboard-set-admin-password <user>   (new password on stdin)
#
#  - changes only a user that is already in the file; no other options;
#  - the password comes on stdin, never on the command line (the process
#    list would show it); 12 to 128 characters; bcrypt (htpasswd -B);
#  - the file keeps its owner, group and mode (root:www-data 640);
#  - logs "admin password changed for <user>" to syslog, never the password.
# ============================================================================
set -u
umask 077
FILE="${BPQ_ADMIN_HTPASSWD:-/etc/nginx/.bpq-mgmt-auth}"
[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 2; }
[[ $# -eq 1 ]] || { echo "usage: $0 <user>  (password on stdin)" >&2; exit 2; }
USER_NAME="$1"
[[ "$USER_NAME" =~ ^[A-Za-z0-9._@][A-Za-z0-9._@-]{0,63}$ ]] || { echo "bad user name" >&2; exit 2; }
[[ -f "$FILE" && ! -L "$FILE" ]] || { echo "password file $FILE not found" >&2; exit 3; }
cut -d: -f1 "$FILE" | grep -qxF -- "$USER_NAME" || { echo "no such admin user" >&2; exit 4; }
command -v htpasswd >/dev/null 2>&1 || { echo "htpasswd not installed (apt install apache2-utils)" >&2; exit 5; }

IFS= read -r PW || true
LEN=${#PW}
(( LEN >= 12 && LEN <= 128 )) || { echo "password must be 12 to 128 characters" >&2; exit 6; }
[[ "$PW" != *:* ]] || { echo "password may not contain ':'" >&2; exit 6; }

OWNER=$(stat -c '%u:%g' "$FILE"); MODE=$(stat -c '%a' "$FILE")
TMP=$(mktemp "$(dirname "$FILE")/.bpq-mgmt-auth.XXXXXX") || exit 7
cp -p "$FILE" "$TMP"
if printf '%s\n' "$PW" | htpasswd -iB "$TMP" "$USER_NAME" >/dev/null 2>&1; then
    chown "$OWNER" "$TMP" && chmod "$MODE" "$TMP" && mv -f "$TMP" "$FILE"
    unset PW
    logger -t bpq-dashboard "admin password changed for $USER_NAME" 2>/dev/null
    echo "ok"
    exit 0
fi
rm -f "$TMP"; unset PW
echo "htpasswd failed" >&2
exit 8

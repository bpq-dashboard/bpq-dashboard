#!/usr/bin/python3 -I
"""
bpq-dashboard-audio-map — read-only facts for Admin > Audio Map (v1.5.57)

Installed as a root-owned copy in /usr/local/sbin (install.sh / update.sh
copy it from tools/audio-map-helper when the sudo rule is there); the web
server runs it with `sudo -n /usr/local/sbin/bpq-dashboard-audio-map`, no
arguments (www-data-tools.sudoers allows exactly that). It needs root only
to see other users' processes and the sound cards' mixers.

It prints one JSON object and changes nothing:
  holders  every process with a sound device open (/dev/snd/pcmC<card>D<dev>
           p = playback, c = capture): pid, program name, user, systemd unit
           (or "session" for a desktop login), the devices, the ALSA sharing
           segments it is attached to (dmix / dsnoop ipc_key, from the SYSV
           entries in /proc/<pid>/maps), and the TCP ports it listens on.
  shm      SysV shared-memory segments: key, processes attached.
  mixer    per card, the simple mixer controls (amixer -c N scontents):
           playback / capture level in % and dB, on/off; null when amixer
           could not read the card.
  wine     wineserver processes and the ports they listen on (under Wine
           the program's sockets are held by wineserver, not the .exe).
  asoundrc each sound user's own ~/.asoundrc (their own ALSA devices), read
           only if it is a regular file owned by that user, not a link,
           at most 64 KB.
No command lines or environment are read or printed (a command line can
hold a password).
"""
import json
import os
import pwd
import re
import subprocess
import time

SND = re.compile(r'^/dev/snd/(pcmC(\d+)D(\d+)([pc]))$')


def _read(path, default=''):
    try:
        with open(path, 'r', encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return default


def listen_sockets(root='/'):
    """inode -> {addr, port, conn} for TCP sockets in LISTEN (0A) or ESTABLISHED
    (01). A modem like VARA stops listening once LinBPQ has connected; its
    connected socket still shows the port (conn = True)."""
    out = {}
    for name, v6 in (('tcp', False), ('tcp6', True)):
        for line in _read(os.path.join(root, 'proc/net', name)).splitlines()[1:]:
            f = line.split()
            if len(f) < 10 or f[3] not in ('0A', '01'):
                continue
            hexaddr, hexport = f[1].split(':')
            port = int(hexport, 16)
            if v6:
                if set(hexaddr) == {'0'}:
                    addr = '::'
                elif hexaddr == '00000000000000000000000001000000':
                    addr = '::1'
                elif hexaddr.startswith('0000000000000000FFFF0000'):
                    addr = '.'.join(str(x) for x in bytes.fromhex(hexaddr[24:])[::-1])
                else:
                    addr = 'ipv6'
            else:
                addr = '.'.join(str(x) for x in bytes.fromhex(hexaddr)[::-1])
            out[f[9]] = {'addr': addr, 'port': port, 'conn': f[3] == '01'}
    return out


def ports_of(inodes, socks):
    """The ports a process serves: its listening sockets, plus the local port
    of connected ones that is below 32768 (a server side, not an outgoing
    connection's ephemeral port)."""
    seen = {}
    for i in inodes:
        x = socks.get(i)
        if not x or (x['conn'] and x['port'] >= 32768):
            continue
        k = x['port']
        if k not in seen or (seen[k]['conn'] and not x['conn']):
            seen[k] = x
    return [{'addr': v['addr'], 'port': v['port'], **({'conn': True} if v['conn'] else {})} for v in sorted(seen.values(), key=lambda v: v['port'])]


def unit_of(root, pid):
    """The systemd service a process runs under, 'session' for a login, '' unknown."""
    for line in _read(os.path.join(root, 'proc', pid, 'cgroup')).splitlines():
        path = line.split(':', 2)[-1]
        m = re.search(r'/([^/]+\.service)(?:/|$)', path)
        if m and not m.group(1).startswith(('user@', 'session-')):
            return m.group(1)
        if 'session-' in path or 'user@' in path or '/app.slice' in path:
            return 'session'
    return ''


def user_of(root, pid):
    status = _read(os.path.join(root, 'proc', pid, 'status'))
    uid = re.search(r'^Uid:\s+(\d+)', status, re.M)
    if not uid:
        return '', None
    try:
        return pwd.getpwuid(int(uid.group(1))).pw_name, int(uid.group(1))
    except KeyError:
        return uid.group(1), int(uid.group(1))


def asoundrc(uid):
    """A user's ~/.asoundrc, only a regular file of their own (no links), <= 64 KB."""
    try:
        home = pwd.getpwuid(uid).pw_dir
        fd = os.open(os.path.join(home, '.asoundrc'), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except (KeyError, OSError):
        return None
    try:
        st = os.fstat(fd)
        import stat
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 65536:
            return None
        return os.read(fd, 65536).decode('utf-8', 'replace')
    finally:
        os.close(fd)


def collect(root='/'):
    socks = listen_sockets(root)
    holders, wine = [], []
    proc = os.path.join(root, 'proc')
    for pid in sorted((p for p in os.listdir(proc) if p.isdigit()), key=int):
        fddir = os.path.join(proc, pid, 'fd')
        try:
            fds = os.listdir(fddir)
        except OSError:
            continue
        devs, inodes = set(), set()
        for fd in fds:
            try:
                t = os.readlink(os.path.join(fddir, fd))
            except OSError:
                continue
            m = SND.match(t)
            if m:
                devs.add(m.group(1))
            elif t.startswith('socket:['):
                inodes.add(t[8:-1])
        comm = _read(os.path.join(proc, pid, 'comm')).strip()[:32]
        if comm == 'wineserver':
            user, _ = user_of(root, pid)
            ls = ports_of(inodes, socks)
            if ls:
                wine.append({'pid': int(pid), 'user': user[:32], 'listen': ls})
            continue
        if not devs:
            continue
        user, uidn = user_of(root, pid)
        keys = set()
        for line in _read(os.path.join(proc, pid, 'maps')).splitlines():
            m = re.search(r'/SYSV([0-9a-fA-F]{8})\b', line)
            if m:
                keys.add(int(m.group(1), 16))
        listen = ports_of(inodes, socks)
        holders.append({
            'pid': int(pid),
            'comm': comm,
            'user': user[:32],
            'uid': uidn,
            'unit': unit_of(root, pid)[:64],
            'devices': sorted(devs),
            'shm_keys': sorted(keys),
            'listen': listen,
        })
    shm = []
    for line in _read(os.path.join(proc, 'sysvipc/shm')).splitlines()[1:]:
        f = line.split()
        if len(f) >= 7:
            try:
                shm.append({'key': int(f[0]), 'nattch': int(f[6])})
            except ValueError:
                pass
    return {'holders': holders, 'shm': shm, 'wine': wine}


def parse_scontents(text):
    """amixer scontents -> [{name, playback:{pct,db,on}, capture:{...}}]."""
    ctls, cur = [], None
    for line in text.splitlines():
        m = re.match(r"Simple mixer control '(.+)',(\d+)", line)
        if m:
            cur = {'name': m.group(1)[:40] + ('' if m.group(2) == '0' else ' ' + m.group(2))}
            ctls.append(cur)
            continue
        if cur is None or not re.match(r'\s+(Mono|Front Left|Front Right|Left|Right)\s*:', line):
            continue
        for way in ('Playback', 'Capture'):
            k = way.lower()
            if k in cur:
                continue
            m = re.search(way + r'\s+(?:(-?\d+)\s+)?(?:\[(\d+)%\])?\s*(?:\[(-?[\d.]+)dB\])?\s*(?:\[(on|off)\])?', line)
            if m and (m.group(2) or m.group(4)):
                cur[k] = {'pct': int(m.group(2)) if m.group(2) else None,
                          'db': float(m.group(3)) if m.group(3) else None,
                          'on': None if m.group(4) is None else m.group(4) == 'on'}
    return [c for c in ctls if 'playback' in c or 'capture' in c]


def amixer_cmds(n):
    """Ways to run amixer for card n, in order. The web server (php-fpm) often
    runs with a private /dev (systemd PrivateDevices=yes) without the sound
    devices, and this helper inherits it. Then amixer is run in the system's
    own mount namespace (nsenter -t 1 -m), or else as a one-off systemd unit
    outside the web server's sandbox (systemd-run --pipe --wait). Read-only
    either way."""
    cmd = ['/usr/bin/amixer', '-c', n, 'scontents']
    if os.path.exists('/dev/snd/controlC' + n) or not os.path.exists('/proc/asound/card' + n):
        return [cmd]
    out = []
    for ns in ('/usr/bin/nsenter', '/bin/nsenter'):
        if os.path.exists(ns):
            out.append([ns, '-t', '1', '-m', '--'] + cmd)
            break
    if os.path.exists('/usr/bin/systemd-run'):
        out.append(['/usr/bin/systemd-run', '--quiet', '--pipe', '--wait', '--collect',
                    '--description=BPQ Dashboard Audio Map: read mixer'] + cmd)
    return out or [cmd]


def mixers(root='/'):
    out = {}
    for line in _read(os.path.join(root, 'proc/asound/cards')).splitlines():
        m = re.match(r'\s*(\d+)\s+\[', line)
        if not m:
            continue
        n = m.group(1)
        out[n] = None
        for cmd in amixer_cmds(n):
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=8,
                                   env={'PATH': '/usr/bin:/bin', 'LANG': 'C'})
            except (OSError, subprocess.SubprocessError):
                continue
            if r.returncode == 0 and 'Simple mixer control' in r.stdout:
                out[n] = parse_scontents(r.stdout)
                break
            if r.returncode == 0 and cmd[0].endswith('amixer'):
                out[n] = []                      # a card with no controls
                break
    return out


def main():
    d = collect('/')
    d['mixer'] = mixers('/')
    d['asoundrc'] = {}
    for h in d['holders']:
        if h.get('uid') is not None and h['user'] not in d['asoundrc']:
            t = asoundrc(h['uid'])
            if t is not None:
                d['asoundrc'][h['user']] = t
    d['generated_at'] = time.strftime('%Y-%m-%d %H:%M:%S', time.gmtime())
    d['helper'] = 1
    print(json.dumps(d))


if __name__ == '__main__':
    main()

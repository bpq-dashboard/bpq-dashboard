[Unit]
Description=BPQ Dashboard: VARA HF callsign check (proxy between BPQ and VARA HF)
Documentation=file:///var/www/bpq-dashboard/USER-MANUAL.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# v1.5.19: runs as the web user from the dashboard folder (was User=pi and
# /usr/local/bin, which only existed on one station). Settings: config.php
# 'vara_validator'. Log: /var/log/bpq-dashboard/vara-validator.log
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /var/www/bpq-dashboard/scripts/vara-callsign-validator.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

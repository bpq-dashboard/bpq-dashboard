# BPQ Dashboard — read-only system commands for the admin pages
# (admin/firewall-api.php and admin/system-audit-api.php). 2026-10-25.
#
# Install:  sudo cp www-data-tools.sudoers /etc/sudoers.d/www-data-tools
#           sudo chmod 440 /etc/sudoers.d/www-data-tools
#           sudo visudo -c
#
# Each line allows exactly one command with exactly these arguments, as the
# admin pages run it (sudo -n, so a missing rule is reported on the page,
# never a password prompt). Nothing here can change the system.
# If your web server runs as another user than www-data, change the first
# word of every line. Paths are the Debian / Ubuntu ones; check with
# `command -v iptables ip6tables fail2ban-client ss nginx`.

# Firewall rules, all chains (ufw and fail2ban keep theirs in own chains)
www-data ALL=(root) NOPASSWD: /usr/sbin/iptables -L -n --line-numbers -v
www-data ALL=(root) NOPASSWD: /usr/sbin/ip6tables -L -n --line-numbers -v

# fail2ban: the jail list, then each jail. Both lines are needed: in sudoers
# "*" needs at least one argument, so it doesn't cover bare "status".
www-data ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status
www-data ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status *

# Listening ports with program names (-p needs root)
www-data ALL=(root) NOPASSWD: /usr/bin/ss -tlnp

# nginx configuration test (reads the config, changes nothing)
www-data ALL=(root) NOPASSWD: /usr/sbin/nginx -t

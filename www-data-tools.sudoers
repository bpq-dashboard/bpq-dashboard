# BPQ Dashboard — read-only system commands for the admin pages
# (admin/firewall-api.php and admin/system-audit-api.php). 2026-10-25.
#
# Install:  sudo cp www-data-tools.sudoers /etc/sudoers.d/www-data-tools
#           sudo chmod 440 /etc/sudoers.d/www-data-tools
#           sudo visudo -c
#
# Each line allows exactly one command with exactly these arguments, as the
# admin pages run it (sudo -n, so a missing rule is reported on the page,
# never a password prompt). Nothing here can change the system.
# If your web server runs as another user than www-data, change the first
# word of every line. Paths are the Debian / Ubuntu ones; check with
# `command -v iptables ip6tables fail2ban-client ss nginx`.

# Firewall rules, all chains (ufw and fail2ban keep theirs in own chains)
www-data ALL=(root) NOPASSWD: /usr/sbin/iptables -L -n --line-numbers -v
www-data ALL=(root) NOPASSWD: /usr/sbin/ip6tables -L -n --line-numbers -v

# fail2ban: the jail list, then each jail. Both lines are needed: in sudoers
# "*" needs at least one argument, so it doesn't cover bare "status".
www-data ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status
www-data ALL=(root) NOPASSWD: /usr/bin/fail2ban-client status *

# Listening ports with program names (-p needs root)
www-data ALL=(root) NOPASSWD: /usr/bin/ss -tlnp

# nginx configuration test (reads the config, changes nothing)
www-data ALL=(root) NOPASSWD: /usr/sbin/nginx -t

# v1.5.19: Maintenance page > Change admin password. The helper is a root-owned
# copy in /usr/local/sbin (install.sh puts it there from tools/set-admin-password;
# never point this at the web folder, which the web user can write). It changes
# only an existing admin login, reads the password on stdin and logs no secret.
www-data ALL=(root) NOPASSWD: /usr/local/sbin/bpq-dashboard-set-admin-password *

# v1.5.57: Admin > Audio Map. Who has which sound card open (through which
# dmix/dsnoop), the ports those programs listen on, and the cards' mixer
# levels, read from /proc and amixer. Root-owned copy in /usr/local/sbin
# (install.sh / update.sh put it there from tools/audio-map-helper); "" = no
# arguments allowed. It reads only and prints no command lines or secrets.
www-data ALL=(root) NOPASSWD: /usr/local/sbin/bpq-dashboard-audio-map ""

# v1.5.94: Admin > LinBPQ Status. LinBPQ's starts, stops and crashes (system
# journal, kernel log, coredumpctl) and a copy of its console (its journal, or
# its screen window via `screen -X hardcopy`, as the session's owner). Root-
# owned copy in /usr/local/sbin (from tools/linbpq-status-helper); only "" (no
# arguments) and "console" are allowed. Read-only: it sends nothing to LinBPQ
# and masks password / USER= lines.
www-data ALL=(root) NOPASSWD: /usr/local/sbin/bpq-dashboard-linbpq-status ""
www-data ALL=(root) NOPASSWD: /usr/local/sbin/bpq-dashboard-linbpq-status console
